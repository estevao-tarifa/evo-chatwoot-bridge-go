# deploy/example.env — environment template for the bridge.
#
#   1. cp deploy/example.env deploy/.env
#   2. chmod 600 deploy/.env
#   3. replace every CHANGE_ME / example.com placeholder
#
# Every variable the binary reads is listed here; the names, defaults and the
# required/optional posture come from `backend/internal/config/config.go` (the
# only source of truth). An empty variable means "unset". A variable that is set
# but invalid makes the process exit at startup with a message — it never starts
# half-configured.
#
# Never commit `deploy/.env`. Never paste its contents into an issue or a log
# (see SECURITY.md).
#
# Generate the two mandatory secrets with:
#     openssl rand -base64 32

# ── HTTP ─────────────────────────────────────────────────────────────────────
# Optional, default 3000. Port the container listens on. Keep it in step with
# the `ports:` mapping and the healthcheck in docker-compose.prod.yml.
PORT=3000

# ── Database ─────────────────────────────────────────────────────────────────
# Required (no default). `mysql://USER:PASSWORD@HOST:3306/DATABASE`.
# HOST must resolve from inside the bridge container — the MySQL service or
# container name on the shared Docker network (e.g. `mysql`, `db`). The URL is
# parsed strictly: only `tls=...` query parameters are accepted, so do not paste
# mysql2/drizzle query strings. Without it the connection pool never opens and
# /readyz stays unavailable.
DATABASE_URL=mysql://bridge:CHANGE_ME_DB_PASSWORD@mysql:3306/bridge

# ── Logging ──────────────────────────────────────────────────────────────────
# Optional, default info. One of: debug | info | warn | error.
LOG_LEVEL=info

# ── CORS ─────────────────────────────────────────────────────────────────────
# Optional, default empty (no cross-origin access). Comma-separated exact
# browser origins; wildcards are rejected. Leave empty when the SPA is served
# from the same origin as the API through your reverse proxy (recommended — the
# session cookie stays first-party). Set it only if the SPA is on another
# origin, and then also set COOKIE_SAMESITE=none with COOKIE_SECURE=true.
CORS_ALLOWED_ORIGINS=

# ── Public base URL of this bridge ───────────────────────────────────────────
# Required to register webhooks: without it the webhook endpoints and the
# webhook-URL readbacks answer 400 ("bridge url is not configured").
# Absolute http(s) URL, no trailing slash, no path, no userinfo/query/fragment.
# This is the URL Evolution GO and Chatwoot will POST to, so it must be
# reachable from them — normally the public HTTPS hostname in front of the
# bridge, not the container's port mapping.
BRIDGE_URL=https://bridge.example.com

# ── Admin bootstrap ──────────────────────────────────────────────────────────
# Optional, but the two go together: set both or leave both empty. When both are
# set, the first start seeds that admin user — only while `admin_users` is
# empty. Leave both empty if you use POST /api/v1/auth/setup or an admin row
# already exists.
ADMIN_USER=
ADMIN_PASS=

# ── Deployment environment ───────────────────────────────────────────────────
# Optional, default production. production | development. Keep `production`:
# it is what makes the two secrets below mandatory (fail-fast) and what makes
# the session cookie `Secure` by default.
APP_ENV=production

# ── Secrets ──────────────────────────────────────────────────────────────────
# Required unless APP_ENV=development (>= 32 random bytes). Derives every
# per-connection webhook path token:
#   base64url(HMAC-SHA256(WEBHOOK_TOKEN_SECRET, "webhook:" + connectionID))
# Rotating it invalidates both webhook URLs of every connection — re-register
# them with Evolution GO and Chatwoot afterwards.
WEBHOOK_TOKEN_SECRET=CHANGE_ME_openssl_rand_base64_32

# Optional, default empty. When set, the Chatwoot ingress requires a valid
# account-webhook HMAC and fails closed (401). Leave empty for the standard
# API-inbox delivery, which is unsigned and authenticated by the path token
# alone. Do not set it unless your Chatwoot account webhook actually signs.
CHATWOOT_WEBHOOK_SECRET=

# Required unless APP_ENV=development (>= 32 random bytes). Signs the admin
# session cookie. A restart invalidates every issued session by design
# (per-process nonce), so rotating it logs all admins out.
SESSION_SECRET=CHANGE_ME_openssl_rand_base64_32

# ── Session cookie posture ───────────────────────────────────────────────────
# Optional, default true in production and false in development. Keep true
# whenever the admin surface is served over HTTPS; a browser will not send a
# Secure cookie over plain HTTP.
COOKIE_SECURE=true
# Optional, default lax. lax | strict | none. `none` requires COOKIE_SECURE=true
# and is only needed for the cross-origin SPA setup.
COOKIE_SAMESITE=lax

# ── Worker pool (optional, defaults shown) ───────────────────────────────────
# Max admitted-but-unfinished jobs before the ingress answers 503.
QUEUE_CAPACITY=1024
# Byte budget for queued payloads (64 MiB).
QUEUE_MAX_BYTES=67108864
# Fixed worker pool size.
WORKERS=8
# Graceful drain budget on SIGTERM before the process exits.
DRAIN_TIMEOUT=30s
# Boot-reconcile cutoff for stale claims. The binary enforces a 15m floor.
STALE_AGE=15m

# ── Compose-only (not read by the binary) ────────────────────────────────────
# Host port published by docker-compose.prod.yml; the container keeps PORT.
BRIDGE_HOST_PORT=8100
# Name of the EXTERNAL Docker network shared with your MySQL container.
# Create it with: docker network create bridge-db-net (or point this at an
# existing network your MySQL is already attached to).
DB_NETWORK=bridge-db-net
