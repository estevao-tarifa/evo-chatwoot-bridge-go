# evo-chatwoot-bridge backend — environment configuration.
# Copy to .env or set the variables in the deployment environment.
# The values below are placeholders; never commit real credentials.

# HTTP listen port (default: 3000).
PORT=3000

# MySQL connection URL, same format as the legacy deployment (drizzle/mysql2).
# The storage layer converts it to a go-sql-driver DSN.
# Example: mysql://bridge:CHANGE_ME@mysql:3306/bridge
DATABASE_URL=mysql://bridge:CHANGE_ME@localhost:3306/bridge

# Structured log level: debug | info | warn | error (default: info).
LOG_LEVEL=info

# Exact browser origins allowed for CORS, comma-separated; credentials are
# allowed for these origins. Empty means no cross-origin access. Wildcards
# are rejected. Example: https://bridge.example
CORS_ALLOWED_ORIGINS=

# Public base URL of this bridge, used to register webhook URLs with
# Evolution GO and Chatwoot. No trailing slash. Example:
# https://bridge.example
BRIDGE_URL=

# Bootstrap admin credentials (ADR-0006): when both are set, the first
# startup seeds the admin user. Set both or neither; never commit real values.
ADMIN_USER=
ADMIN_PASS=

# Deployment environment: production (default) | development. Production is
# the default posture: WEBHOOK_TOKEN_SECRET is required (fail-fast if absent)
# unless APP_ENV is explicitly development.
APP_ENV=development

# Per-connection webhook path token secret (ADR-0006 Amendment 2). The token is
# derived, never stored: base64url(HMAC-SHA256(WEBHOOK_TOKEN_SECRET,
# "webhook:" + connectionID)). Required unless APP_ENV=development; never
# logged. Rotating it rotates every connection's token.
WEBHOOK_TOKEN_SECRET=

# Optional Chatwoot webhook HMAC secret (ADR-0006 Amendment 3). When set, the
# deferred Chatwoot ingress requires a valid signature and fails closed. Never
# logged.
CHATWOOT_WEBHOOK_SECRET=

# Admin session cookie signing secret (ADR-0006 §1.4, Amendment 5). The session
# token is base64url(admin_id|exp|version|instance_nonce) + "." +
# HMAC-SHA256(SESSION_SECRET). The per-process instance_nonce means a restart
# invalidates every previously issued session, and multi-replica deployments
# need sticky sessions (each process has its own nonce). Required unless
# APP_ENV=development; never logged. Use >= 32 random bytes.
SESSION_SECRET=

# Session cookie posture. COOKIE_SECURE defaults to true (and is turned off only
# for local HTTP development); COOKIE_SAMESITE is lax | strict | none.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Bounded worker pool (ADR-0005). QUEUE_CAPACITY is the max admitted-but-
# unfinished jobs, QUEUE_MAX_BYTES the byte budget, WORKERS the fixed pool size,
# DRAIN_TIMEOUT the graceful drain budget, STALE_AGE the boot-reconcile cutoff
# (>= 15m).
QUEUE_CAPACITY=1024
QUEUE_MAX_BYTES=67108864
WORKERS=8
DRAIN_TIMEOUT=30s
STALE_AGE=15m
